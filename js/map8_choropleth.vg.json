{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where the world plays",
    "subtitle": [
      "Relative search interest in collectible card games, 2021-2026",
      "Grey = no data"
    ],
    "anchor": "start"
  },
  "width": 800,
  "height": 400,
  "projection": {"type": "equalEarth"},
  "data": {
    "url": "https://raw.githubusercontent.com/LiyanDai1207/tcg_visualization/main/js/ne_110m_admin_0_countries.topojson",
    "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
  },
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "fill": "#e8e8e8",
        "stroke": "white",
        "strokeWidth": 0.5
      }
    },
    {
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/LiyanDai1207/tcg_visualization/main/data/tcg_interest_by_country.csv"
            },
            "key": "Region",
            "fields": ["Collectible card game"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.5},
      "encoding": {
        "color": {
          "title": "Search interest (0-100)",
          "field": "Collectible card game",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [10, 20, 30, 45, 60],
            "range": [
              "#ffffcc",
              "#c7e9b4",
              "#7fcdbb",
              "#41b6c4",
              "#2c7fb8",
              "#253494"
            ]
          }
        },
        "tooltip": [
          {"field": "properties.NAME", "type": "nominal", "title": "Country"},
          {
            "field": "Collectible card game",
            "type": "quantitative",
            "title": "Search interest (0-100)"
          }
        ]
      }
    }
  ]
}
